# ===========================================================================
# chezmoi External Dependencies
# ===========================================================================

# Oh My Zsh
[".oh-my-zsh"]
    type = "archive"
    url = "https://github.com/ohmyzsh/ohmyzsh/archive/refs/heads/master.tar.gz"
    stripComponents = 1
    refreshPeriod = "168h"

# zsh-autosuggestions
[".oh-my-zsh/custom/plugins/zsh-autosuggestions"]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-autosuggestions/archive/refs/heads/master.tar.gz"
    stripComponents = 1
    refreshPeriod = "168h"

# zsh-syntax-highlighting
[".oh-my-zsh/custom/plugins/zsh-syntax-highlighting"]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-syntax-highlighting/archive/refs/heads/master.tar.gz"
    stripComponents = 1
    refreshPeriod = "168h"

# zsh-completions
[".oh-my-zsh/custom/plugins/zsh-completions"]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-completions/archive/refs/heads/master.tar.gz"
    stripComponents = 1
    refreshPeriod = "168h"

# fzf-tab
[".oh-my-zsh/custom/plugins/fzf-tab"]
    type = "archive"
    url = "https://github.com/Aloxaf/fzf-tab/archive/refs/heads/master.tar.gz"
    stripComponents = 1
    refreshPeriod = "168h"

# Claude Code config — your fork of mirus-tech/jmz/claude-config.
# You own this repo, so chezmoi only ever pulls YOUR changes (no surprise
# conflicts). Pull Joerg's updates on your schedule from the `upstream` remote
# configured in ~/.claude: `git fetch upstream && git merge upstream/master`.
[".claude"]
    type = "git-repo"
    url = "https://git.mirus-tech.com/dalpago/claude-config.git"
    refreshPeriod = "168h"
    exact = false
    exclude = [
        ".git/**",
        ".gitignore",
        "settings.json",
        "mcp-servers.json",
        "docs/**",
        "scripts/cleanup-runtime.sh",
        "scripts/install-standalone.sh",
        "scripts/setup-mcp-servers.sh",
        "scripts/sync-upstream.sh",
        "scripts/validate-config.sh",
    ]

# oh-my-tmux (gpakosz/.tmux)
[".config/tmux/oh-my-tmux"]
    type = "archive"
    url = "https://github.com/gpakosz/.tmux/archive/refs/heads/master.tar.gz"
    stripComponents = 1
    refreshPeriod = "168h"

# MesloLGS Nerd Font — provides the powerline/icon glyphs used by
# dot_config/starship.toml; the Mono variant (MesloLGSNFM) is the font of the
# iTerm2 dynamic profile. Installed per user rather than as a brew cask:
# Homebrew on this Mac is shared between accounts, and font casks only land in
# ~/Library/Fonts of whichever account ran `brew install`.
{{- if eq .chezmoi.os "darwin" }}
{{- range $family := list "MesloLGSNerdFont" "MesloLGSNerdFontMono" }}
{{- range list "Regular" "Bold" "Italic" "BoldItalic" }}
["Library/Fonts/{{ $family }}-{{ . }}.ttf"]
    type = "archive-file"
    url = "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/Meslo.tar.xz"
    path = "{{ $family }}-{{ . }}.ttf"
{{- end }}
{{- end }}
{{- end }}

# Private overlay externals (optional)
{{- $localExternal := joinPath .chezmoi.sourceDir ".local/.chezmoiexternal.local.toml" -}}
{{- if stat $localExternal }}
{{ include $localExternal }}
{{- end }}
