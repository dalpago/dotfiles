#!/usr/bin/env bash
#
# tmux-mobile — attach to a phone-sized view of a tmux session.
#
# tmux sizes a session to its smallest attached client, so attaching a phone
# directly to a desktop session shrinks the desktop's view to phone width.
# A grouped session (`new-session -t`) shares the target's windows but keeps
# its own size and current-window, so each client renders at its own
# dimensions. Paired with `aggressive-resize on` in .tmux.conf.local.
#
# Usage: tmux-mobile [session-name]    (default: data-generation)

set -euo pipefail

# A non-login SSH shell may not inherit Homebrew's PATH.
if [ -x /opt/homebrew/bin/tmux ]; then
  PATH="/opt/homebrew/bin:$PATH"
fi

TARGET="${1:-data-generation}"
VIEW="mobile-${TARGET}"

# '=' forces an exact session-name match, so 'mobile-foo' can never
# accidentally resolve to 'mobile-foobar' via tmux's prefix matching.

# Reuse the mobile view if one is already open.
if tmux has-session -t "=${VIEW}" 2>/dev/null; then
  exec tmux attach-session -t "=${VIEW}"
fi

# Group onto the target session if it exists.
if tmux has-session -t "=${TARGET}" 2>/dev/null; then
  exec tmux new-session -s "${VIEW}" -t "${TARGET}"
fi

# Target does not exist yet — start it plainly rather than failing.
exec tmux new-session -s "${TARGET}"
